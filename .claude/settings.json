{
  "extraKnownMarketplaces": {
    "relevo": {
      "source": {
        "source": "github",
        "repo": "elalfner/relevo",
        "sparsePaths": [
          ".claude-plugin"
        ]
      }
    }
  },
  "enabledPlugins": {
    "relevo@relevo": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && ! command -v openspec >/dev/null 2>&1 && OPENSPEC_TELEMETRY=0 npm install --global @fission-ai/openspec || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && { claude plugin marketplace add elalfner/relevo --sparse .claude-plugin --scope local && claude plugin install relevo@relevo --scope local; } >\"${TMPDIR:-/tmp}/relevo-plugin-hook.log\" 2>&1 || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.testing)",
      "Read(**/.env.dev)",
      "Read(**/.env.prod)",
      "Read(**/.env.qa)",
      "Read(**/.env.ci)",
      "Read(**/.env.preview)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.p8)",
      "Read(**/*.ppk)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.pypirc)",
      "Read(**/.git-credentials)",
      "Read(**/.pgpass)",
      "Read(**/.htpasswd)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/key.properties)",
      "Read(./secrets/**)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "**/.env",
        "**/.env.*.local",
        "**/.env.local",
        "**/.env.development",
        "**/.env.production",
        "**/.env.staging",
        "**/.env.test",
        "**/.env.testing",
        "**/.env.dev",
        "**/.env.prod",
        "**/.env.qa",
        "**/.env.ci",
        "**/.env.preview",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.p8",
        "**/*.ppk",
        "**/*.keystore",
        "**/*.jks",
        "**/id_rsa",
        "**/id_dsa",
        "**/id_ecdsa",
        "**/id_ed25519",
        "**/.npmrc",
        "**/.netrc",
        "**/.pypirc",
        "**/.git-credentials",
        "**/.pgpass",
        "**/.htpasswd",
        "**/google-services.json",
        "**/GoogleService-Info.plist",
        "**/key.properties",
        "./secrets"
      ]
    }
  }
}
